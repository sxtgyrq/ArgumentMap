<Window x:Class="WpfArgumentMap.LinePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="线路属性" Width="560" Height="760" MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="BorderBrush" Value="#CCD6E3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,7"/><Setter Property="MinWidth" Value="88"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#E6EDF5"/></Style>
    </Window.Resources>
    <Border Background="#F3F6FA" Padding="24">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="LineHeading" FontSize="23" FontWeight="SemiBold" Foreground="#22324A"/>
            <TextBlock x:Name="LineIdentity" Foreground="#667085" Margin="0,7,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EditablePanel">
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="基本信息" FontWeight="SemiBold" FontSize="15" Foreground="#22324A" Margin="0,0,0,12"/>
                        <TextBlock Text="线路名称" Foreground="#667085" Margin="0,0,0,5"/>
                        <TextBox x:Name="NameInput" MaxLength="15" Margin="0,0,0,12"/>
                        <TextBlock Text="线路说明" Foreground="#667085" Margin="0,0,0,5"/>
                        <TextBox x:Name="DetailInput" MaxLength="127" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="线路方向" FontWeight="SemiBold" FontSize="15" Foreground="#22324A" Margin="0,0,0,10"/>
                        <ComboBox x:Name="PassDirectionInput" Padding="9,6" MinHeight="32">
                            <ComboBoxItem Content="单向：沿节点顺序正向通行"/>
                            <ComboBoxItem Content="双向：正向与反向均可通行"/>
                        </ComboBox>
                        <TextBlock Text="正向通行固定为 1，不可修改。正向按节点 0 → 1 → 2…；关闭后在主窗口按 C 反转方向。" Foreground="#667085" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="速度" FontWeight="SemiBold" FontSize="15" Foreground="#22324A" Margin="0,0,0,10"/>
                        <Grid>
                            <TextBox x:Name="SpeedInput" MaxLength="3" ToolTip="请输入 5–500 的整数速度"/>
                        </Grid>
                        <TextBlock Text="输入 5–500 的整数。" Foreground="#667085" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="SaveStatus" Grid.Row="2" TextWrapping="Wrap" Foreground="#B44635" Margin="0,12,0,10" MinHeight="25"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="关闭" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="保存属性" Background="#3478C8" Foreground="White" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
