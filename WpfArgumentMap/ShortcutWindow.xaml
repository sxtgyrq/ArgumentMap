<Window x:Class="WpfArgumentMap.ShortcutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="快捷键与操作说明" Width="760" Height="720" MinWidth="560" MinHeight="420"
 WindowStartupLocation="CenterOwner" Background="#F5F8FC" FontFamily="Segoe UI, Microsoft YaHei" PreviewKeyDown="Window_PreviewKeyDown">
 <Border Padding="22" Background="#F5F8FC">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,16">
    <TextBlock Text="快捷键" FontSize="24" FontWeight="SemiBold" Foreground="#172B4D"/>
    <TextBlock Text="地图内使用绘图按键 · Alt + F / E / C / V / H 打开对应菜单" Foreground="#667085" Margin="0,5,0,0" TextWrapping="Wrap"/>
   </StackPanel>
   <Grid Grid.Row="1" Margin="0,0,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Label Content="搜索(_S)" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center" Padding="0,0,10,0"/>
    <TextBox x:Name="SearchBox" Grid.Column="1" Padding="10,8" BorderBrush="#CCD8E8" Background="White"
     TextChanged="Search_TextChanged" ToolTip="输入操作名称、按键或说明，例如：交点、F6、锁定"/>
   </Grid>
   <Grid Grid.Row="2">
    <ScrollViewer x:Name="ShortcutScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl x:Name="ShortcutGroups">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,12">
         <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,10"/>
          <ItemsControl ItemsSource="{Binding Entries}">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="#EFF4FB" CornerRadius="4" Padding="7,4" Margin="0,0,12,0" VerticalAlignment="Top">
               <TextBlock Text="{Binding Keys}" FontFamily="Consolas, Microsoft YaHei" FontWeight="SemiBold" Foreground="#344054" TextWrapping="Wrap"/>
              </Border>
              <StackPanel Grid.Column="1">
               <TextBlock Text="{Binding Action}" FontWeight="SemiBold" Foreground="#344054"/>
               <TextBlock Text="{Binding Detail}" Foreground="#667085" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
             </Grid>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <TextBlock x:Name="EmptyResults" Text="没有找到匹配的快捷键，请换个关键词。" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
   </Grid>
   <DockPanel Grid.Row="3" Margin="0,12,0,0">
    <Button DockPanel.Dock="Right" Content="关闭  Esc" IsCancel="True" Padding="16,6" Click="Close_Click"/>
    <TextBlock x:Name="ResultCount" Foreground="#667085" VerticalAlignment="Center"/>
   </DockPanel>
  </Grid>
 </Border>
</Window>
