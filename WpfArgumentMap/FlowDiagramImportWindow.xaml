<Window x:Class="WpfArgumentMap.FlowDiagramImportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="导入 ChatGPT 给我的流程图" Width="840" Height="780" MinWidth="620" MinHeight="480"
 Background="#F5F8FC" FontFamily="Segoe UI, Microsoft YaHei" WindowStartupLocation="CenterOwner"
 Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="导入 ChatGPT 给我的流程图" FontSize="24" FontWeight="SemiBold" Foreground="#172B4D"/>
   <TextBlock Text="粘贴 ArgumentMap Flow v1 JSON → 选择插入点 → 校验预览 → 确认导入" Foreground="#667085" Margin="0,6,0,0" TextWrapping="Wrap"/>
   <TextBlock x:Name="LogicRequirementHint" Text="LN6、LN12、LN18 的 logic 必填且非空白，最多 255 字符。LN4：值只能为 True／False，logic 可为空；非空时 True 对应 P、False 对应 ¬P，P 必须对应唯一 LN6 的完整逻辑语言。LN8：值只能为 =／→／↔／⊇／⊋／⊆／⊊，logic 必须与 value 完全一致；漏填或空串自动补齐，明确不一致则拒绝；连接类型按绘图约定，自由放置。LN10：value 必须含英文字母，小写且可重复，需对应含英文字母的大写值 LN12；logic 自动生成 value ∈ 大写值（可省略或空串），明确不一致拒绝。所有 logic 均不允许 null。" Foreground="#9A5700" Margin="0,6,0,0" TextWrapping="Wrap"/>
   <TextBlock x:Name="UniquenessRequirementHint" Text="LN12：value 转大写后全图唯一，logic 可重复。LN6：logic 区分大小写、全图唯一，value 可重复。导入按新增处理，仅 LN12 的重复 value、LN6 的重复 logic 自动加数字；同批 LN4 引用跟随 LN6 更新。LN10 的 value、logic 可重复，隶属按 LN12 的 value 校验；同批父节点编号时实例同步。LN4、LN8 的固定值可重复；LN8 全图数量不限。预览不预占，以提交结果为准。" Foreground="#667085" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
   <TextBlock x:Name="ImportDefaultsHint" Text="所有 LN 的 value、logic 只能为单行，不能包含换行；info 说明允许换行。道路默认速度 100；路口优先双向连通或不连通，尽量避免单向换路。" Foreground="#667085" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid x:Name="InputPanel" Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,8">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="GuideButton" Content="制作与格式说明" Padding="10,5" Margin="0,0,8,0" Click="Guide_Click"/>
     <Button x:Name="ExampleButton" Content="载入设备排查示例" Padding="10,5" Click="Example_Click"/>
    </StackPanel>
    <TextBlock Text="流程图文本" VerticalAlignment="Center" Foreground="#344054" FontWeight="SemiBold"/>
   </DockPanel>
   <TextBox x:Name="SourceText" Grid.Row="1" FontFamily="Consolas, Microsoft YaHei" FontSize="13" Padding="10"
    AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
    BorderBrush="#CCD8E8" TextChanged="Input_Changed"/>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
   <StackPanel>
    <TextBlock Text="插入点：origin 指定的 LN 中心" FontWeight="SemiBold" Foreground="#344054"/>
    <WrapPanel x:Name="OriginPanel" Margin="0,8,0,0">
     <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="XInput" Width="130" Padding="7,5" Margin="0,0,16,0" TextChanged="Input_Changed"/>
     <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="YInput" Width="130" Padding="7,5" Margin="0,0,16,0" TextChanged="Input_Changed"/>
     <Button x:Name="PickButton" Content="在地图上选择插入点" Padding="10,5" Click="Pick_Click"/>
    </WrapPanel>
    <TextBlock Text="X、Y 必须是整数＋0.5。线路点保持整数；地图选点自动吸附。相对布局整体平移，所有现有规则仍须满足。" TextWrapping="Wrap" FontSize="12" Foreground="#667085" Margin="0,8,0,0"/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Row="3" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
   <TextBlock x:Name="Status" Text="预览只做校验，确认导入才保存。任何冲突都会整次回滚。" TextWrapping="Wrap" Foreground="#667085"/>
  </ScrollViewer>
  <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
   <TextBlock Text="F1 制作说明 · 地图预览时 Enter 返回 · Esc 取消" Foreground="#667085" VerticalAlignment="Center" MaxWidth="190" TextWrapping="Wrap"/>
   <Button x:Name="ImportButton" DockPanel.Dock="Right" Content="确认导入" IsEnabled="False" Padding="18,8" Background="#2563EB" Foreground="White" Margin="8,0,0,0" Click="Import_Click"/>
   <Button x:Name="MapPreviewButton" DockPanel.Dock="Right" Content="查看地图" IsEnabled="False" Padding="14,8" Margin="8,0,0,0" Click="MapPreview_Click"/>
   <Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="校验并预览" Padding="14,8" Margin="8,0,0,0" Click="Preview_Click"/>
   <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="取消" Padding="14,8" Click="Close_Click"/>
  </DockPanel>
 </Grid>
</Window>
