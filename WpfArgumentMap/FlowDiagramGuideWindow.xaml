<Window x:Class="WpfArgumentMap.FlowDiagramGuideWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="流程图制作与导入说明" Width="1080" Height="820" MinWidth="760" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="#F5F8FC" FontFamily="Segoe UI, Microsoft YaHei" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,6"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#344054"/>
   <Setter Property="BorderBrush" Value="#CCD8E8"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="流程图制作与导入说明" FontSize="26" FontWeight="SemiBold" Foreground="#172B4D"/>
   <TextBlock Text="把完整协议交给 ChatGPT → 提供资料或要求自行检索 → 生成合格数据 → 校验并导入" Foreground="#667085" Margin="0,6,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#EBF1FA" CornerRadius="8" Padding="12">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="阅读目录" Foreground="#344054" FontWeight="SemiBold" Margin="4,2,0,12"/>
     <ListBox x:Name="ContentsList" BorderThickness="0" Background="Transparent" SelectionChanged="Contents_SelectionChanged"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="#344054"/></DataTemplate></ListBox.ItemTemplate>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,8"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListBox.ItemContainerStyle>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="8" Padding="8">
    <RichTextBox x:Name="GuideReader" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Background="White"
      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14"/>
   </Border>
  </Grid>
  <TextBlock x:Name="Status" Grid.Row="2" Text="首次接触本软件也能使用：复制完整协议，粘贴给对方的 ChatGPT，填写末尾的资料或检索主题。可离线阅读。"
    Foreground="#667085" Margin="0,12,0,10" TextWrapping="Wrap"/>
  <DockPanel Grid.Row="3" LastChildFill="True">
   <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="关闭" Click="Close_Click" Margin="8,0,0,6" IsCancel="True"/>
   <WrapPanel>
    <Button x:Name="CopyGuideButton" Content="复制完整说明" Click="CopyGuide_Click"/>
    <Button x:Name="CopyTaskButton" Content="复制给 ChatGPT 的完整协议" Background="#2563EB" Foreground="White" Click="CopyTask_Click"/>
    <Button x:Name="CopyMinimalButton" Content="复制最小示例" Click="CopyMinimal_Click"/>
    <Button x:Name="CopyBranchButton" Content="复制分支示例" Click="CopyBranch_Click"/>
   </WrapPanel>
  </DockPanel>
 </Grid>
</Window>
