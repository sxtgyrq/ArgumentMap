<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/ArgumentMap.runsettings</RunSettingsFilePath>
    <VSTestResultsDirectory>$(MSBuildProjectDirectory)/../.artifacts/test-results</VSTestResultsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WpfArgumentMap/WpfArgumentMap.csproj"/>
    <Compile Include="../tools/EquipmentDiagramData.cs" Link="Fixtures/EquipmentDiagramData.cs"/>
    <ProjectReference Include="../ArgumentMap.Server/ArgumentMap.Server.csproj" />
  </ItemGroup>
</Project>
